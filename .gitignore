# Python temporary files
__pycache__/
*.py[cod]
.pytest_cache/

# Yerel backend log dosyaları (run_file_receiver.py::_configure_logging) -
# öğretmen/öğrenci verisi taşımaz (yalnızca kod/sebep/sayı) ama yine de
# yerel makineye özgü çalışma zamanı çıktısı, depoya girmemeli.
backend/logs/

# Yerel ortam değişkeni dosyaları - depoya girmemeli.
.env
.env.*
# Şablon dosyası anahtar taşımaz; `.env.*` deseninin istisnası (local/.env.example).
!.env.example
secrets.local.txt

# Yerel LLM çalışma dosyaları (local/llm_server.ps1): llama.cpp binary'leri ve
# GGUF model dosyaları - GB boyutunda, depoya girmemeli.
local/llama.cpp/
local/models/
