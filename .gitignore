# Python temporary files
__pycache__/
*.py[cod]
.pytest_cache/

# Yerel backend log dosyaları (run_file_receiver.py::_configure_logging) -
# öğretmen/öğrenci verisi taşımaz (yalnızca kod/sebep/sayı) ama yine de
# yerel makineye özgü çalışma zamanı çıktısı, depoya girmemeli.
backend/logs/

# Yerel ortam değişkeni dosyaları - depoya girmemeli.
.env
.env.*
# Şablon dosyası anahtar taşımaz; `.env.*` deseninin istisnası (local/.env.example).
!.env.example

# Yerel LLM çalışma dosyaları (local/llm_server.ps1): llama.cpp binary'leri ve
# GGUF model dosyaları - GB boyutunda, depoya girmemeli.
local/llama.cpp/
local/models/

# Gömülü Qdrant indeksi (local/qdrant_index/) KASITLI olarak depoya girer:
# birkaç MB'lık bir yapı çıktısıdır, klonlayan herkes hazır indeksle gelsin
# (bkz. README "Müfredat indeksi hazır gelir"). Yalnız çalışma zamanı kilit
# dosyası dışlanır - o, indeksi açmış olan sürece özgüdür.
local/qdrant_index/.lock

# Marp sunum çıktıları. `sunum.html` KASITLI olarak depoya girer: klonlayan
# herkes Node/Marp kurmadan sunumu açabilsin diye. Kaynağı değişince YENİDEN
# ÜRETİLİP commit'lenmeli, yoksa sessizce bayatlar (komut README'de).
# PDF/PPTX çıktıları izlenmez - büyük ikili dosyalar, gerektiğinde üretilir.
sunum.pdf
sunum.pptx
