# MAHİR yerel RAG hattı - ortam değişkeni şablonu.
#
# Kopyalayın:  copy local\.env.example local\.env   (PowerShell/cmd)
#              cp local/.env.example local/.env     (bash)
# `local/.env` .gitignore'da; gerçek anahtarı YALNIZCA oraya yazın.
# `rag_common.Settings.from_env()` bu dosyayı okur; verilmeyen değerler için
# aşağıdaki varsayılanlar geçerlidir. Bir değişken ortamda zaten tanımlıysa
# ortamdaki değer kazanır (.env onu ezmez).

# --- Üretim (LLM) - YEREL llama-server, Qwen2.5-7B-Instruct GGUF Q4_K_M ---------
# Her şey yerel: rag_service.py OpenAI uyumlu istemciyle aşağıdaki uca konuşur,
# dışarıya istek çıkmaz. Sunucuyu `powershell -File local/llm_server.ps1`
# başlatır (bu dosyadaki LLAMA_*/LLM_* ayarlarını okur). Yalnız rag_service.py
# kullanır; ingestion_pipeline.py LLM'e hiç dokunmaz.
LLM_BASE_URL=http://127.0.0.1:8080/v1
# llama-server anahtar istemez. Başka bir OpenAI uyumlu uca geçilirse doldurun.
LLM_API_KEY=
# Günlük/yanıt etiketi ve llama-server `--alias` değeri (/v1/models bunu döndürür).
MODEL_NAME=qwen2.5-7b-instruct-q4_k_m
# llama-server'ın `-c` penceresiyle AYNI olmalı: rag_service bağlam bütçesini
# (LLM_CONTEXT_WINDOW - LLM_MAX_TOKENS - ~512 şablon) x 2,5 karakter/token ile
# türetir ve sığmayan parçaları kırpar. 8k, KV önbelleği q8_0 ile ~235 MB.
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
# Yerel 7B modelde uzun bağlam + üretim; GPU'da tipik 5-15 sn, CPU'ya taşan
# katman varsa dakikalar sürebilir.
LLM_TIMEOUT_S=180

# llm_server.ps1 ayarları -------------------------------------------------------------
# llama-server.exe yolu. Boşsa local/llama.cpp/llama-server.exe aranır. İndirme:
#   https://github.com/ggml-org/llama.cpp/releases (b10976 ve üstü)
#   -> llama-bNNNNN-bin-win-cuda-12.4-x64.zip  +  cudart-llama-bin-win-cuda-12.4-x64.zip
#   ikisini de local/llama.cpp/ içine açın (cudart paketi CUDA runtime DLL'lerini
#   taşır; sistem CUDA'sından bağımsızdır, NVIDIA sürücüsü yeterli).
LLAMA_SERVER_EXE=
# Model kaynağı (1): Hugging Face deposu:kuant - tek dosya (4,68 GB), ilk
# çalıştırmada indirilir ve llama.cpp önbelleğine (%LOCALAPPDATA%/llama.cpp) alınır.
LLM_HF_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
# Model kaynağı (2): yerel GGUF dosyası - doluysa LLM_HF_REPO yok sayılır. Resmî
# Qwen deposu iki parçalı; indirip İLK parçanın yolunu yazın:
#   hf download Qwen/Qwen2.5-7B-Instruct-GGUF --include "qwen2.5-7b-instruct-q4_k_m-*" --local-dir local/models
#   LLM_GGUF_PATH=local/models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
LLM_GGUF_PATH=
# GPU'ya taşınacak katman sayısı: 99 = tümü (28 katman). Q4_K_M ~4,7 GB ağırlık
# + KV ~0,25 GB (q8_0, 8k) + hesap tamponu ~0,4 GB ≈ 5,4 GB -> 6 GB'a sığar ama
# masaüstü/ekran VRAM'i de paylaşır. Başlangıçta "CUDA out of memory" görürseniz
# 24'e düşürün (katman başına ~150 MB); CPU'da kalan katman üretimi yavaşlatır.
LLM_GPU_LAYERS=99
LLM_PORT=8080
# KV önbellek tipi: q8_0 belleği fp16'ya göre yarıya indirir, kalite kaybı ihmal
# edilebilir; llama-server'da q8_0 V-önbelleği flash attention gerektirir (betik açar).
LLM_KV_CACHE_TYPE=q8_0
# CPU'da kalan katmanlar / prompt işleme için iş parçacığı (0 -> fiziksel çekirdek).
LLM_THREADS=0

# --- Qdrant (bkz. docker-compose.yml) -------------------------------------------
# "localhost" YAZMAYIN: Windows'ta istemci önce ::1'i dener, Docker Desktop
# yalnız IPv4 loopback'e bağlıdır; reddedilen IPv6 denemesi her Qdrant
# isteğine ~2 s ekler (ölçüldü). 127.0.0.1 ile aynı istek ~5 ms.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# docker-compose.yml'de QDRANT__SERVICE__API_KEY açıldıysa aynı değeri buraya yazın.
QDRANT_API_KEY=
# Koleksiyon adı şemayı taşır (1024-d dense, cosine). Gömme modeli ya da
# parçalama değişirse YENİ bir ad verin - Qdrant var olan koleksiyonun vektör
# boyutunu değiştiremez, eski koleksiyon dokunulmadan yerinde kalır.
QDRANT_COLLECTION=mahir_local_chunks_v1

# --- Gömme (CPU) ------------------------------------------------------------------
# bge-m3: çok dilli, 1024-d. Kasıtlı olarak CPU'da: 6 GB VRAM PaddleOCR-VL'ye
# (indeksleme/OCR işçisi) ve llama-server'a (servis) kalır.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# 0 -> fiziksel çekirdek sayısı (torch.set_num_threads). Hyper-threading'li
# CPU'larda mantıksal çekirdek sayısını vermek genelde YAVAŞLATIR.
EMBEDDING_THREADS=0
EMBEDDING_BATCH_SIZE=8
# HybridChunker parça üst sınırı (bge-m3 tokenizer'ıyla sayılır).
CHUNK_MAX_TOKENS=512

# --- OCR / görsel anlama (GPU) - PaddleOCR-VL 1.6 ------------------------------
OCR_ENABLED=true
# PaddlePaddle cihaz adı: "gpu:0" ya da "cpu" (CPU'da VLM çok yavaştır, yalnız test için).
OCR_DEVICE=gpu:0
# "transformers" (HF generate, KV-cache'li, hızlı) ya da "paddle_dynamic"
# (yalnız Paddle, yavaş ama Triton/derleyici gerektirmez). Windows'ta
# transformers motoru Triton isterse: `pip install "triton-windows<3.5"` ya da
# bu değeri paddle_dynamic yapın.
OCR_ENGINE=transformers
# Görselin uzun kenarı bu pikseli aşarsa küçültülür - VLM aktivasyon belleğini
# sınırlar (OOM'da hat bir kez daha 0,7x küçültüp yeniden dener).
OCR_MAX_IMAGE_SIDE=1600
# pypdf'in metin katmanından bu kadar karakterden azını okuduğu sayfa
# "taranmış" sayılır ve tümüyle PaddleOCR-VL'ye gider.
OCR_MIN_TEXT_CHARS_PER_PAGE=40
# Metinli sayfalardaki görsellerden kısa kenarı bundan küçük olanlar (ikon,
# logo, ayraç çizgisi) OCR'a gönderilmez.
OCR_MIN_FIGURE_SIDE_PX=120
# PaddleX her pipeline kurulumunda uzak model kaynaklarını yokluyor ve
# dakikalarca bekletebiliyor (bkz. backend/app/ocr_engine.py) - kapatıyoruz.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# Model indirme kaynağı (varsayılan BOS/AIStudio, Türkiye'den yavaş olabilir).
# PADDLE_PDX_MODEL_SOURCE=HuggingFace
# 6 GB VRAM'de parçalanmayı (fragmentation) azaltır; torch import edilmeden
# ÖNCE ortamda olmalı - Settings bu değeri süreç ortamına da yazar.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Reranker (sorgu anı, cross-encoder) ------------------------------------------
RERANKER_ENABLED=true
# bge-m3 ile aynı aile, Türkçe dahil çok dilli. İlk çalıştırmada ~2,2 GB iner.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cpu (varsayılan): 6 GB VRAM sorgu anında llama-server'a (Q4_K_M ~5,4 GB)
# ayrılmıştır; fp16 reranker (~1,2-1,5 GB) yanına sığmaz. "cuda"/"auto" ancak
# LLM_GPU_LAYERS düşürülüp (~20) yer açıldığında anlamlı; OOM'da hat kendiliğinden
# CPU'ya düşer ama gecikme yaşanır. CPU'da 12 aday/640 token ≈ 8-12 sn (i7).
RERANKER_DEVICE=cpu
# Reranker'a girecek aday havuzu: max(top_k * MULTIPLIER, MIN_CANDIDATES). CPU
# maliyeti havuzla doğrusal büyür (12 aday ≈ 20'nin %60'ı). Getirim kalitesine
# etkisi belgeye göre değişir - /retrieve ile rerank açık/kapalı karşılaştırın.
RERANKER_CANDIDATE_MULTIPLIER=3
RERANKER_MIN_CANDIDATES=12
RERANKER_BATCH_SIZE=8
# (soru + parça) çifti için token üst sınırı; parçalar en çok 512 token, soru
# kısa - 640 yeterli, daha uzunu CPU süresini boşa artırır.
RERANKER_MAX_LENGTH=640
# Sigmoid skoru bunun altındaki adaylar elenir (en az bir isabet her zaman
# kalır). 0 -> eleme kapalı, yalnız yeniden sıralama.
RERANKER_MIN_SCORE=0.0

# --- Docling (CPU) -----------------------------------------------------------------
# 0 -> fiziksel çekirdek sayısı.
DOCLING_THREADS=0

# --- Servis ---------------------------------------------------------------------------
# Web backend'in (backend/run_file_receiver.py) varsayılan MAHIR_RAG_REMOTE_URL
# değeri http://127.0.0.1:8001/agents - host/port burada değişirse orada da
# (env değişkeniyle) değişmeli.
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8001
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
# Reranker KAPALIYKEN: en iyi isabetin skorunun bu oranı altındaki isabetler
# atılır (göreli eşik; mutlak kosinüs eşiği belgeye göre kaydığı için değil).
RAG_RELATIVE_SCORE_FLOOR=0.5

# --- OCR işçisi (backend/run_ocr_worker.py) ------------------------------------------
# Web backend görsel yüklemeleri http://127.0.0.1:8002'ye iletir (varsayılan
# MAHIR_OCR_REMOTE_URL). Bu değişkeni işçi süreci okur; .env'i değil, kabuk
# ortamını (backend/ python-dotenv kullanmaz).
# MAHIR_OCR_WORKER_PORT=8002

# --- Genel ------------------------------------------------------------------------------
# Hugging Face model önbelleği (bge-m3 ~2,2 GB + reranker ~2,2 GB). Boş -> HF varsayılanı.
# HF_HOME=D:\hf-cache
# Modeller bir kez indikten sonra tamamen çevrimdışı çalışmak için (HF Hub'a
# hiç istek çıkmaz; önbellekte olmayan model açık hata verir):
# HF_HUB_OFFLINE=1
LOG_LEVEL=INFO
